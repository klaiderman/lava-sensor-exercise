# PROFILE C — restricted/hostile, built FROM the profile A image (real Ubuntu 24.04
# userspace, not fake hardware). This is the fix for the external adversarial review's
# "Docker Gate" finding: the previous profile C only set PATH=/nonexistent, which
# internal/probe/exec.go's resolveBinary deliberately ignores (fixed candidate
# directories, never the caller's PATH — a documented safety property, not a bug),
# so profile C was byte-identical to profile A. This image removes the actual
# binaries and denies the actual paths, so every EACCES/UTILITY_MISSING/ENOENT this
# profile produces is real, not simulated.
#
# What this profile denies, mechanically:
#   - utilities actually absent from the filesystem: nvme, mdadm, lsblk, findmnt,
#     lspci, ss, ip, ufw, getcap, mokutil, sshd (every PATH location, not just one)
#   - chmod 0000: /etc/ssh, /etc/ssl/private, /var/lib/cloud, /run/udev (created if
#     they did not already exist, so the denial is on a real directory, not a miss)
#   - /etc/ufw/*.rules chmod 0000 (ufw's own binary is also gone, so this denies the
#     config-file fallback path too, not just the exec path)
#   - run_in_docker.sh additionally runs this image as uid:gid 4242:4242, which has
#     no /etc/passwd entry and no home directory, and masks /proc/net and
#     /sys/class/dmi with empty read-only tmpfs mounts — those are docker-run-time
#     properties, not buildable into the image, so they live in run_in_docker.sh.
#
# What this profile does NOT and cannot deny (structural, documented per CLAUDE.md
# "never claim a container equals the bare-metal host"): there is still a real /sys
# and /proc supplied by the container runtime's kernel, so checks whose primary
# evidence is sysfs/procfs (not exec, not a config file) will still read *something*
# — just the container host's, not the Lava host's, and every /sys-derived field is
# expected to carry describes_host_kernel/execution_context annotation, not a denial.
FROM lava-sensor-testlab:profileA

USER root

# Remove the actual binaries from every directory on the fixed candidate list
# internal/probe/exec.go's resolveBinary consults (/usr/sbin, /usr/bin, /sbin, /bin),
# so there is no location left for the sensor's own resolver to find them at,
# independent of any PATH manipulation.
RUN for b in nvme mdadm lsblk findmnt lspci ss ip ufw getcap mokutil sshd; do \
      rm -f /usr/sbin/$b /usr/bin/$b /sbin/$b /bin/$b; \
    done

# Deny real directories, creating them first if profile A's install did not.
RUN mkdir -p /etc/ssh /etc/ssl/private /var/lib/cloud /run/udev /etc/ufw \
    && printf '# denied\n' > /etc/ufw/user.rules \
    && printf '# denied\n' > /etc/ufw/before.rules \
    && printf '# denied\n' > /etc/ufw/after.rules \
    && chmod 0000 /etc/ufw/user.rules /etc/ufw/before.rules /etc/ufw/after.rules \
    && chmod 0000 /etc/ssh /etc/ssl/private /var/lib/cloud /run/udev

USER root
WORKDIR /home/ubuntu/sensor
CMD ["/bin/sh"]
