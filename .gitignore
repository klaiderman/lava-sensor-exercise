# secrets / credentials — never commit
.env
.env.*
*.pem
*.key
id_*
!id_*.pub
*.ppk
known_hosts.lava

# raw session transcripts / raw host artifacts stay local by default
ai/transcripts/raw/
state/raw_host/

# build outputs
sensor/bin/
sensor/dist/
submission/*.tar.gz
submission/*.tgz

# research-worker scratch (Crawlee request queues/kv stores, repro build outputs)
research/*/storage/
research/*/repro/*.exe
research/*/repro/*_bin

# workbench never lives here
.lava-workbench/
node_modules/
__pycache__/
.venv/
venv/

# reviewer scratch copies of the module (kept locally, not history)
reports/review/sensorcopy/
reports/review/*.test
