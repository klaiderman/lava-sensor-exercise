# secrets / credentials — never commit
.env
.env.*
*.pem
*.key
id_*
!id_*.pub
*.ppk
known_hosts.lava

# raw session transcripts / raw host artifacts stay local by default
ai/transcripts/raw/
state/raw_host/

# build outputs
sensor/bin/
sensor/dist/
submission/*.tar.gz
submission/*.tgz

# research-worker scratch (Crawlee request queues/kv stores, repro build outputs)
research/*/storage/
research/*/repro/*.exe
research/*/repro/*_bin

# workbench never lives here
.lava-workbench/
node_modules/
__pycache__/
.venv/
venv/

# reviewer scratch copies of the module (kept locally, not history)
reports/review/sensorcopy/
reports/review/*.test
submission/transcripts/
submission/stage/
submission/*.tar.gz

# external review inputs supplied by the user and derived transcript renderings (local only)
Claude outputs/
ai/transcripts/normalized/
reports/claude-transcript.html
reports/claude-transcript-data.json

# reviewer scratch: module copies and compiled test binaries (logs stay in history)
reports/review*/sensorcopy/
reports/review*/*.test
reports/review*/sensor.linux
reports/panel/sensorcopy/
reports/panel/*.test

# compiled Go test binaries anywhere
*.test
